{
  "expo": {
    "name": "MathOff",
    "slug": "mathoff",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/logo.png",

    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#071A24"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "icon": "./assets/logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#071A24"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/logo.png"
    }
  }
}